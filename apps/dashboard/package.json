{
  "name": "@ghec/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:styles && tsc --noEmit && vite build && npm run check:bundle",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:styles": "node scripts/check-styles.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "report:styles": "node scripts/report-legacy-styles.mjs",
    "test:e2e": "playwright test --grep-invert visual",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:visual": "playwright test visual.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots",
    "quality": "npm run typecheck && npm run build && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "@ghec/analysis": "0.1.0",
    "@ghec/contracts": "0.1.0",
    "@primer/octicons-react": "^19.38.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.40.1",
    "@tanstack/react-virtual": "^3.14.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.2.0"
  }
}
