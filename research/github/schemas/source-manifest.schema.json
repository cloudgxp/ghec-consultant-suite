{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghec-consultant-suite/schemas/source-manifest.schema.json",
  "title": "GHEC Research Source Provenance Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "targetApiVersion",
    "generatedAt",
    "methodology",
    "primarySources",
    "documentSourcesIndex",
    "documentSourcesCount"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "product": { "type": "string" },
    "targetApiVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "methodology": { "type": "string" },
    "primarySources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "role", "apiVersion", "retrievedAt", "files"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "role": { "type": "string" },
          "apiVersion": { "type": "string" },
          "gitRevision": { "type": "string" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "format", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "format": { "type": "string", "enum": ["html", "markdown", "json"] },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "sizeBytes": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "extractedMetrics": {
            "type": "object",
            "properties": {
              "rawGetOccurrences": { "type": "integer", "minimum": 0 },
              "uniqueGetOperations": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "documentSourcesIndex": { "type": "string" },
    "documentSourcesCount": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
