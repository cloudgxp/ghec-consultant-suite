{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlicerMatrixContract",
  "description": "Validates the partitioned cohort matrix output generated by the preflight slicer.",
  "type": "object",
  "required": ["schemaVersion", "cohortCount", "matrix"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cohortCount": {
      "type": "integer",
      "minimum": 0
    },
    "matrix": {
      "type": "object",
      "required": ["include"],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cohortId", "runnerLabels", "repositories", "tier"],
            "additionalProperties": false,
            "properties": {
              "cohortId": {
                "type": "string"
              },
              "runnerLabels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "repositories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tier": {
                "type": "string",
                "enum": [
                  "standard",
                  "large-releases",
                  "git-lfs",
                  "massive-mirror"
                ]
              },
              "useGei": {
                "type": "boolean"
              },
              "skipReleases": {
                "type": "boolean"
              },
              "useReleaseFallback": {
                "type": "boolean"
              },
              "useLfsStreamer": {
                "type": "boolean"
              },
              "useMirrorPush": {
                "type": "boolean"
              },
              "requiresHeadroomCheck": {
                "type": "boolean"
              },
              "estimatedScratchBytes": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
