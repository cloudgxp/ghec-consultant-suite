{
  "version": "1.0.0",
  "name": "test-repo-wave",
  "organizations": [
    {
      "source": "example-source-org",
      "target": "example-target-emu"
    }
  ],
  "repositories": [
    {
      "sourceOrg": "example-source-org",
      "sourceRepo": "dummy-repo-public",
      "targetOrg": "example-target-emu",
      "targetRepo": "dummy-repo-public",
      "useGei": true,
      "targetRepoVisibility": "public",
      "modules": [
        "repo-variables",
        "repo-secrets",
        "repo-settings",
        "repo-custom-properties",
        "rulesets",
        "branch-protection",
        "environments",
        "webhooks"
      ]
    },
    {
      "sourceOrg": "example-source-org",
      "sourceRepo": "dummy-repo-private-lfs",
      "targetOrg": "example-target-emu",
      "targetRepo": "dummy-repo-private-lfs",
      "useGei": true,
      "targetRepoVisibility": "private",
      "skipReleases": false,
      "lfsStrategy": "dual-remote-stream",
      "modules": ["repo-settings", "repo-custom-properties", "rulesets"]
    }
  ],
  "identityMapping": {
    "strategy": "emu-saml",
    "suffix": "_gxp"
  }
}
